<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net7.0;net8.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<Version>0.0.11</Version>
		<Authors>Raypro</Authors>
		<RootNamespace>Tgs.GameFundTransfer.Client</RootNamespace>
		<PackageId>Tgs.GameFundTransfer.Client</PackageId>
		<Title>Tgs.GameFundTransfer.Client</Title>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-gamefundtransfer</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-gamefundtransfer.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>TGS GameFundTransfer Client</PackageTags>
	</PropertyGroup>
	
	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.59.0" />
		<PackageReference Include="Grpc.Net.ClientFactory" Version="2.59.0" />
		<PackageReference Include="Grpc.Tools" Version="2.60.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="..\Tgs.GameFundTransfer\Potos\gamefundtransfer.proto" GrpcServices="Client">
			<Link>gamefundtransfer.proto</Link>
		</Protobuf>
	</ItemGroup>

</Project>
