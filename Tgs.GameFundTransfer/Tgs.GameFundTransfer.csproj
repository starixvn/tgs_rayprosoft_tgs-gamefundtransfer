<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>bdc85ead-1f9e-4194-8843-d5fd265b491d</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU' or 
				   '$(Configuration)|$(Platform)'=='Release|AnyCPU' or
				   '$(Configuration)|$(Platform)'=='dev|AnyCPU' or 
				   '$(Configuration)|$(Platform)'=='staging|AnyCPU'or
				   '$(Configuration)|$(Platform)'=='prod|AnyCPU'">
		<DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
		<NoWarn>$(NoWarn);1591;0063</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Potos\gamefundtransfer.proto" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="FluentdForward.OpenTelemetry.MessagePack" Version="0.2.0" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.17.0" />
		<PackageReference Include="Npgsql.OpenTelemetry" Version="7.0.1" />
		<PackageReference Include="OpenTelemetry.Contrib.Instrumentation.EntityFrameworkCore" Version="1.0.0-beta2" />
		<PackageReference Include="OpenTelemetry.Contrib.Instrumentation.GrpcCore" Version="1.0.0-beta3" />
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.3.2" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.0.0-rc8" />
		<PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.0.0-rc8" />
		<PackageReference Include="OpenTelemetry.Instrumentation.GrpcCore" Version="1.0.0-beta.5" />
		<PackageReference Include="OpenTelemetry.Instrumentation.GrpcNetClient" Version="1.0.0-rc9.3" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.0.0-rc8" />
		<PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
		<PackageReference Include="ProfileViewer.OpenTelemetry.Exporter" Version="0.2.1" />
		<PackageReference Include="StackExchange.Redis" Version="2.6.86" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
		<PackageReference Include="Grpc.AspNetCore" Version="2.50.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Tgs.GameFundTransfer.Core\Tgs.GameFundTransfer.Core.csproj" />
		<ProjectReference Include="..\Tgs.GameFundTransfer.Repositories\Tgs.GameFundTransfer.Repositories.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="Potos\gamefundtransfer.proto" GrpcServices="Server" />
	</ItemGroup>

</Project>
